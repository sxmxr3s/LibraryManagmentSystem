package libraryManagementSystem;

import java.io.BufferedReader;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * This class manages the collections of books and users,
 * as well as the borrowing relationships between them.
 * It provides methods to add books/users and to borrow/return books.
 * It also supports saving and loading the library data to/from a file.
 * 
 * @author samar
 * @author dayanna
 * @author chanel
 */
public class Library {
    private List<Book> books;
    private List<User> users;
    private Map<User, List<Book>> borrowedBooks;

    /**
     * Initializes the collections used in the Library.
     */
    public Library() {
        books = new ArrayList<>();
        users = new ArrayList<>();
        borrowedBooks = new HashMap<>();
    }

    /**
     * Gets the number of books that a user has currently borrowed.
     * 
     * @param user The user.
     * @return Count of borrowed books.
     */
    public int getBorrowedCount(User user) {
        List<Book> list = borrowedBooks.get(user);
        return (list == null) ? 0 : list.size();
    }

    /**
     * Adds a book to the library collection.
     * 
     * @param book The book to add.
     */
    public void addBook(Book book) {
        books.add(book);
    }

    /**
     * Removes a book from the library collection.
     * Also removes it from any borrowed lists.
     * 
     * @param book The book to remove.
     */
    public void removeBook(Book book) {
        books.remove(book);
        // Remove from all borrowed lists
        for (List<Book> list : borrowedBooks.values()) {
            list.remove(book);
        }
    }

    /**
     * Adds a user to the library.
     * 
     * @param user The user to add.
     */
    public void addUser(User user) {
        users.add(user);
    }

    /**
     * Removes a user from the library and clears their borrowed books.
     * 
     * @param user The user to remove.
     */
    public void removeUser(User user) {
        users.remove(user);
        borrowedBooks.remove(user);
    }

    /**
     * Borrows a book for the given user if allowed.
     * 
     * @param user The user borrowing the book.
     * @param book The book to be borrowed.
     */
    public void borrowBook(User user, Book book) {
        if (!book.isAvailable()) {
            System.out.println("Sorry, this book is not available.");
            return;
        }

        int borrowed = getBorrowedCount(user);

        if (borrowed >= user.getMaxBooks()) {
            System.out.println(user.getName() + " has reached max book limit.");
            return;
        }

        borrowedBooks.computeIfAbsent(user, k -> new ArrayList<>()).add(book);
        book.borrowBook();
    }

    /**
     * Returns a book from a user back to the library.
     * 
     * @param user The user returning the book.
     * @param book The book to return.
     */
    public void returnBook(User user, Book book) {
        List<Book> list = borrowedBooks.get(user);

        if (list != null && list.remove(book)) {
            book.returnBook();
        } else {
            System.out.println("Book was not borrowed by this user.");
        }
    }

    /**
     * Saves the library data (books, users, and borrowed relationships)
     * to a text file. Each line represents either a book or a user.
     * 
     * BOOK;isbn;title;author;genre
     * USER;id;name;type;isbnBorrowed1,isbnBorrowed2,...
     * 
     * @param filename Name of the file.
     */
    public void saveToFile(String filename) {
        try (PrintWriter out = new PrintWriter(new FileWriter(filename))) {
            
            for (Book b : books) {
                out.printf("BOOK;%s;%s;%s;%s%n",
                        b.getIsbn(),
                        b.getTitle(),
                        b.getAuthor(),
                        b.getGenre().name());
            }

            for (User u : users) {
                String type = (u instanceof TeacherUser) ? "Teacher" : "Student";
                out.print("USER;" + u.getId() + ";" + u.getName() + ";" + type + ";");

                List<Book> borrowed = borrowedBooks.get(u);
                if (borrowed != null && !borrowed.isEmpty()) {
                    for (int i = 0; i < borrowed.size(); i++) {
                        if (i > 0) {
                            out.print(",");
                        }
                        out.print(borrowed.get(i).getIsbn());
                    }
                }
                out.println();
            }

        } catch (IOException e) {
            System.out.println("Error saving library data: " + e.getMessage());
            e.printStackTrace();
        }
    }

    /**
     * Loads the library data (books, users, and borrowed relationships)
     * from a text file created by saveToFile.
     * Existing data in the library is cleared before loading.
     * 
     * @param filename Name of the file.
     */
    public void loadFromFile(String filename) {
        books.clear();
        users.clear();
        borrowedBooks.clear();

        Map<String, Book> bookByIsbn = new HashMap<>();
        List<String> userLines = new ArrayList<>();

        try (BufferedReader in = new BufferedReader(new FileReader(filename))) {
            String line;

            while ((line = in.readLine()) != null) {
                if (line.isBlank()) {
                    continue;
                }

                String[] parts = line.split(";");
                if (parts.length == 0) {
                    continue;
                }

                if ("BOOK".equals(parts[0]) && parts.length >= 5) {
                    String isbn = parts[1];
                    String title = parts[2];
                    String author = parts[3];
                    Genre genre = Genre.valueOf(parts[4]);

                    Book book = new Book(isbn, title, author, genre, true);
                    books.add(book);
                    bookByIsbn.put(isbn, book);
                } else if ("USER".equals(parts[0])) {
                    userLines.add(line);
                }
            }

            for (String userLine : userLines) {
                String[] parts = userLine.split(";");
                if (parts.length < 4) {
                    continue;
                }

                String id = parts[1];
                String name = parts[2];
                String type = parts[3];

                User user;
                if ("Teacher".equalsIgnoreCase(type)) {
                    user = new TeacherUser(id, name);
                } else {
                    user = new StudentUser(id, name);
                }
                users.add(user);

                if (parts.length >= 5 && !parts[4].isBlank()) {
                    String[] isbns = parts[4].split(",");
                    for (String isbn : isbns) {
                        Book b = bookByIsbn.get(isbn);
                        if (b != null) {
                            borrowedBooks
                                .computeIfAbsent(user, k -> new ArrayList<>())
                                .add(b);
                            b.borrowBook();
                        }
                    }
                }
            }

        } catch (IOException e) {
            System.out.println("Error loading library data: " + e.getMessage());
            e.printStackTrace();
        }
    }

    /**
     * Gets the list of all books.
     * 
     * @return List of books.
     */
    public List<Book> getBooks() {
        return books;
    }

    /**
     * Gets the list of all users.
     * 
     * @return List of users.
     */
    public List<User> getUsers() {
        return users;
    }

    /**
     * Gets the list of books borrowed by a specific user.
     * 
     * @param user The user.
     * @return List of borrowed books, or null if none.
     */
    public List<Book> getBorrowedBooks(User user) {
        return borrowedBooks.get(user);
    }
}
