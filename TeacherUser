package libraryManagementSystem;

/**
 * This class checks the max amount of books a teacher can 
 * borrow and prints it out.
 * 
 * @author samar
 * @author dayanna
 * @author chanel
 */
public class TeacherUser extends User {

    /**
     * Initializes the ID and name from the superclass User.
     * 
     * @param id Teacher ID.
     * @param name Teacher name.
     */
    public TeacherUser(String id, String name) {
        super(id, name, 10);
    }

    /**
     * Tells the teacher what the max amount of books that can be 
     * borrowed is.
     * 
     * @return Maximum books allowed.
     */
    @Override
    public int getMaxBooks() {
        return 10;
    }

    /**
     * Overrides the toString() method and prints it out in this format:
     * 
     * "Teacher User: [{id}, {name}]
     * Maximum Books Allowed: {maxBooks}"
     */
    @Override
    public String toString() {
        return "Teacher User: [" + getId() + ", " + getName() + 
                "]\nMaximum Books Allowed: " + getMaxBooks();
    }
}

