package libraryManagementSystem;

/**
 * This interface allows the user to borrow a book 
 * or return it.
 * 
 * @author samar
 * @author dayanna
 * @author chanel
 */
public interface Borrowable {

	/**
	 * Allows the user to borrow a book if it is available and 
	 * adds the book to the borrowed map.
	 */
	void borrowBook();

	/**
	 * Allows the user to return a book to make it available again
	 * and removes the book from the borrowed map.
	 */
	void returnBook();
}
